NODE_USE_SYSTEM_CA=1
CAMUNDA_AUTH_STRATEGY=BASIC
CAMUNDA_BASIC_AUTH_USERNAME=demo
CAMUNDA_BASIC_AUTH_PASSWORD=demo
CAMUNDA_SECURE_CONNECTION=false
; CAMUNDA_OAUTH_TOKEN=....
; CAMUNDA_OAUTH_URL=http://localhost:18080/auth/realms/camunda-platform/protocol/openid-connect/token

# Camunda 8 Orchestration Cluster API 地址
CAMUNDA_REST_ADDRESS=http://192.168.109.66:30000

; =error, warn, info, http, verbose, debug, silly.
CAMUNDA_LOG_LEVEL=info

# RustFS 配置（替代 MinIO）
RUSTFS_ENDPOINT_URL=http://192.168.109.66:30900
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_BUCKETNAME=ywmast

NEXTJS_API_URL=http://192.168.171.3:3765/report/api

# 数据库配置（Prisma 使用，复用 mainProj 的数据库）
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:password@localhost:3306/sei_db

# 第三方系统认证配置（用户同步任务使用）
# 第三方系统登录账号（必填）
THIRD_PARTY_USERNAME=
# 第三方系统登录密码（必填）
THIRD_PARTY_PASSWORD=
# 第三方系统用户UUID（必填，用于登录验证）
THIRD_PARTY_USER_UUID=

# Prisma 数据库连接字符串
DATABASE_URL=
# SM4 国密加密KEY
SM4_KEY=
# SM2 国密加密私钥,估计已经变了
SM2_PRIVATE_KEY=
SM2_PUBLIC_KEY=

