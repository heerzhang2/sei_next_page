{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM", "ESNext"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "paths": {
//      "page2pdf-server/*": ["../../../page2pdf-server/src/*"] // 路径映射
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
}
