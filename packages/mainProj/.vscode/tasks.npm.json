{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 dev: Run Next.js",
      "type": "shell",
      "command": "yarn",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "server"
      },
      "problemMatcher": []
    },
