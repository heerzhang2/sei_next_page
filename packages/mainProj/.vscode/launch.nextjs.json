{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug (Simple - Like camunda-worker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn",
      "args": ["dev:debug"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229
    },
    {
      "name": "Next.js: Debug with Break (Like camunda-worker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn",
      "args": ["dev:debug:break"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229
    },
    {
      "name": "Next.js: Debug with ts-node-dev (Like camunda-worker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn",
      "args": ["dev:like-camunda"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229
    },
    {
      "name": "Next.js: Direct Debug (Server.mjs)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.mjs",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--inspect-brk"],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}