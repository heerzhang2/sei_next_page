{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Server Side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn",
      "args": ["dev:debug"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "outputCapture": "std"
    },
    {
      "name": "Next.js: Debug Server Side (With Break)",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn",
      "args": ["dev:debug:break"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "outputCapture": "std"
    },
    {
      "name": "Next.js: Debug Server Side (Direct Node)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect",
        "node_modules/next/dist/bin/next"
      ],
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Next.js: Debug Client Side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3765",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/src/*",
        "webpack://_N_E/*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": ["Next.js: Debug Server Side", "Next.js: Debug Client Side"]
    }
  ]
}