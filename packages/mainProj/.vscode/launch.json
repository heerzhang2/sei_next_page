{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: Debug Server-Side",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "localhost": true,
            "timeout": 30000,
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "restart": true,
            "internalConsoleOptions": "neverOpen",
            "env": {
                "NODE_TLS_REJECT_UNAUTHORIZED": "0",
                "SERWIST_SUPPRESS_TURBOPACK_WARNING": "1"
            },
            "preLaunchTask": "clean-and-restart"
        },
        {
            "name": "Next.js: Debug Full Stack",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/next",
            "args": ["dev"],
            "cwd": "${workspaceFolder}",
            "runtimeArgs": ["--inspect"],
            "env": {
                "NODE_OPTIONS": "--inspect",
                "NODE_TLS_REJECT_UNAUTHORIZED": "0"
            },
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "restart": true
        },
        {
            "name": "Attach to Current Process",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/.next/**/*.js"
            ]
        }
    ]
}