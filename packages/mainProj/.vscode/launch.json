{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug dev (F5)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "sourceMaps": true,
            "env": {
                "NODE_OPTIONS": "--inspect"
            }
        }
    ]
}
