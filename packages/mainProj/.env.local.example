NODE_USE_SYSTEM_CA=1
#直接添加.env文件 调试启动就受到两个参数影响了。
#这两个设置仅仅针对开发环境，前端编译文件上传静态服务器的生产环境根本不受它作用的。
HTTPS=false
PORT=3765
NEXT_PUBLIC_BASE_PATH=/report

#本机是后端服务端，在本机电脑的测试：
#REACT_APP_BACK_END=http://192.168.1.105:8673
#REACT_APP_BACK_END=http://localhost:8673

#浏览器直接读取做地址，在手机测试，必须是从外网可以访问的地址。
# 通过 APISIX 网关访问后端 API
NEXT_PUBLIC_BACK_END=https://192.168.171.3:9443/api
NEXT_PUBLIC_TOKEN_EXPIRESEC=3600000

#REACT_APP_BACK_END=http://192.168.3.172:8673

#REACT_APP_BACK_END=http://27.151.117.65:8673
#REACT_APP_BACK_END=http://192.168.0.100:8673
#REACT_APP_BACK_END=https://hanyeyinyong2.123nat.com:8673

REACT_APP_WEBSOCKET_END=wss://192.168.171.3:9443
#REACT_APP_WEBSOCKET_END=wss://hanyeyinyong2.123nat.com:8673

#必须以　REACT_APP_　开头的，创建自定义的环境变量REACT_APP_。任何其他变量NODE_ENV将被忽略
#协议HTTPS=true  安全，跨域要求条件严格。
#API_URL='https://api.react-finland.fi/graphql'


NEXT_PUBLIC_APP_WEB=https://192.168.171.3:9443/report

#MinIO存储服务器地址 @通过 APISIX 网关访问
NEXT_PUBLIC_OSS_ENDP=https://192.168.171.3:9443/minio

#TUS文件上传endpoint @通过 APISIX 网关访问
NEXT_PUBLIC_TUS_UPLOAD_ENDP=https://192.168.171.3:9443/uploadTUS/
#免出现一堆Failed to parse source map from 'C:\home\sei-pageend\principal\node_modules\customize-easy-ui-component\' file: Error: ENOENT: no such file
#太多的告警报错了，屏蔽；解决一个问题，但同时引入另一个毛病需要清除缓存重启环境？
GENERATE_SOURCEMAP=false
NEXT_PUBLIC_APP_TEST=true

# NEXT AUTH
# ===================================
# NEXTAUTH_URL=http://192.168.0.100:3765/report
NEXTAUTH_SECRET=
#NEXT AUTH涉及的provider，客户端用到 - 通过 APISIX 网关
# AUTH_URL=http://192.168.0.100:3765/report/api/auth
# AUTH_URL=https://192.168.0.100:9443/report/api/auth


# 调试模式开关
# 设置为true时启用调试日志
DEBUG=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# 信任代理头部，解决反向代理场景下的 Server Actions 验证问题
NODE_ENV=development
VERCEL_URL=192.168.171.3:9443
VERCEL_SCHEME=https

# ZEEBE_GATEWAY_ADDRESS=localhost:26500  ZEEBE_ADDRESS
REDIS_HOST=192.168.109.66
REDIS_PORT=31379
REDIS_PASSWORD=

PDF_SERVICE_URL=http://localhost:9389
PDF_SERVICE_TOKEN=your-secret-bearer-token
NEXT_PUBLIC_PAGE2PDF_URL=http://localhost:9389

#是nextjs服务端才能使用的配置项目
# ZEEBE_BASE_URL=http://localhost:8080
# ZEEBE_AUDIENCE=zeebe-api
# ZEEBE_ADDRESS=localhost:26500          =NONE  grpc:// or grpcs://
# CAMUNDA_BASE_URL=http://192.168.109.66:9600
# Camunda 8 配置 - 使用 gRPC
# ZEEBE_GATEWAY_ADDRESS=192.168.109.66:31500
CAMUNDA_BASIC_AUTH_USERNAME=demo
CAMUNDA_BASIC_AUTH_PASSWORD=
# ZEEBE_GRPC_ADDRESS=grpc://192.168.109.66:31500
# ZEEBE_REST_ADDRESS=http://192.168.109.66:31500
# CAMUNDA_OPERATE_URL=http://192.168.109.66:31000
# CAMUNDA_TASKLIST_URL=http://192.168.109.66:31000

# TiDB 数据库配置（数据迁移服务使用）
# ===================================
TIDB_HOST=192.168.109.66
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=sei_db
TIDB_SSL=false
# Prisma 数据库连接字符串
# DATABASE_URL="mysql://${TIDB_USER}:${TIDB_PASSWORD}@${TIDB_HOST}:${TIDB_PORT}/${TIDB_DATABASE}?sslaccept=strict"
DATABASE_URL=

# Camunda 8 K3s 生产集群配置
CAMUNDA_REST_ADDRESS=http://192.168.109.66:30000
CAMUNDA_AUTH_STRATEGY=BASIC
CAMUNDA_BASIC_AUTH_USERNAME=demo
CAMUNDA_BASIC_AUTH_PASSWORD=
CAMUNDA_BASE_URL=http://192.168.109.66:31000
CAMUNDA_OPERATE_URL=http://192.168.109.66:31000
CAMUNDA_TASKLIST_URL=http://192.168.109.66:31000

# 第三方系统认证配置（用户同步任务使用）
# 第三方系统登录账号（必填）
THIRD_PARTY_USERNAME=
# 第三方系统登录密码（必填）
THIRD_PARTY_PASSWORD=
# 第三方系统用户UUID（必填，用于登录验证）
THIRD_PARTY_USER_UUID=
GOTENBERG_URL=http://localhost:3001
