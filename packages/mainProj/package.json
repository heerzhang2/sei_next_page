  "scripts": {
    "db:pull": "prisma db pull --force && node prisma/fix-schema.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "yarnAdd": "yarn add @radix-ui/react-combobox",
    "v0dev/Vercel自带组件添加": "npx shadcn@latest add --overwrite alert-dialog",
    "AI胡诌的": "yarn upgrade @radix-ui/react-dialog @radix-ui/react-slot @radix-ui/react-tooltip",
    "dev:pwa": "next dev -p 3765",
    "dev:http": "cross-env NEXT_PUBLIC_BASE_PATH=/report next dev -p 3765",
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NEXT_PUBLIC_BASE_PATH=/report NEXT_PUBLIC_ENABLE_PWA=false next dev -p 3765",
    "dev:debug:break": "cross-env NODE_OPTIONS='--inspect-brk' next dev -p 3765",
    "dev:ts-node": "ts-node --project tsconfig.json -r tsconfig-paths/register node_modules/.bin/next dev",
    "dev:ts-node:debug": "ts-node --inspect -r tsconfig-paths/register node_modules/.bin/next dev",
    "dev:raw": "node --inspect-brk --loader ts-node/esm node_modules/.bin/next dev",
    "dev:server": "node --inspect-brk server.mjs",
    "dev:like-camunda": "cross-env NODE_OPTIONS='--inspect' ts-node-dev --respawn --transpile-only node_modules/.bin/next dev",
    "dev:like-camunda:break": "cross-env NODE_OPTIONS='--inspect-brk' ts-node-dev --respawn --transpile-only node_modules/.bin/next dev",
    "start": "cross-env NODE_ENV=production NEXT_PUBLIC_BASE_PATH=/report NODE_TLS_REJECT_UNAUTHORIZED=0 next start -p 3765",
    "lint": "next lint",
    "start:no-pwa": "cross-env NODE_ENV=production NEXT_PUBLIC_BASE_PATH=/report NEXT_PUBLIC_ENABLE_PWA=false next start -p 3765",
    "start-test-offline2": "cross-env NODE_ENV=production NEXT_PUBLIC_BASE_PATH=/report NODE_TLS_REJECT_UNAUTHORIZED=0 node server.mjs",
    "start:debug": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS='--inspect' SERWIST_SUPPRESS_TURBOPACK_WARNING=1 NEXT_DEV_TURBOPACK=0 node server.mjs",
    "start:debug:break": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS='--inspect-brk' SERWIST_SUPPRESS_TURBOPACK_WARNING=1 NEXT_DEV_TURBOPACK=0 node server.mjs",
    "scan-template": "node scripts/scan-template.mjs",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build:no-pwa": "cross-env NEXT_PUBLIC_ENABLE_PWA=false next build",
    "build:standalone": "cross-env BUILD_STANDALONE=true next build",
    "build": "next build",
    "start:https": "cross-env NODE_ENV=production NODE_TLS_REJECT_UNAUTHORIZED=0 node server.mjs",
    "start2:apisix": "cross-env NODE_ENV=production NODE_TLS_REJECT_UNAUTHORIZED=0 NEXT_PUBLIC_BASE_PATH=/report node server.mjs",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "start:cluster": "cross-env NODE_ENV=production NODE_TLS_REJECT_UNAUTHORIZED=0 node server-cluster.mjs",
    "start:cluster-strict": "cross-env NODE_ENV=production node server-cluster.mjs",
    "schema供参考用_本机": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 get-graphql-schema  http://localhost:8673/graphql > src/auth/schema.graphql",
    "getSchemaforUrql": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 sei_code_tools urqlSchema -u http://localhost:8673/graphql src/auth/urql-schema.json",
    "batch-templates": "powershell -ExecutionPolicy Bypass -File scripts/batch-register-templates.ps1"
  },
