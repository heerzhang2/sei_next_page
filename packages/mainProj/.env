NODE_USE_SYSTEM_CA=1
#直接添加.env文件 调试启动就受到两个参数影响了。
#这两个设置仅仅针对开发环境，前端编译文件上传静态服务器的生产环境根本不受它作用的。
HTTPS=false
PORT=3765
NEXT_PUBLIC_BASE_PATH=/report
#本机是后端服务端，在本机电脑的测试：
#REACT_APP_BACK_END=http://192.168.1.105:8673
#REACT_APP_BACK_END=http://localhost:8673

#浏览器直接读取做地址，在手机测试，必须是从外网可以访问的地址。
REACT_APP_BACK_END=http://192.168.109.66:8673
NEXT_PUBLIC_BACK_END=http://192.168.109.66:8673
NEXT_PUBLIC_TOKEN_EXPIRESEC=3600000

#REACT_APP_BACK_END=http://192.168.3.172:8673

#REACT_APP_BACK_END=http://27.151.117.65:8673
#REACT_APP_BACK_END=http://192.168.0.100:8673
#REACT_APP_BACK_END=https://hanyeyinyong2.123nat.com:8673

REACT_APP_WEBSOCKET_END=wss://192.168.109.66:8673
#REACT_APP_WEBSOCKET_END=wss://hanyeyinyong2.123nat.com:8673

#必须以　REACT_APP_　开头的，创建自定义的环境变量REACT_APP_。任何其他变量NODE_ENV将被忽略
#协议HTTPS=true  安全，跨域要求条件严格。
#API_URL='https://api.react-finland.fi/graphql'


NEXT_PUBLIC_APP_WEB=https://192.168.0.100:9443/report

#MinIO存储服务器地址 @必须用特定前缀，否则浏览器端无法读取的！和服务端看的不一致啊
NEXT_PUBLIC_OSS_ENDP=https://192.168.0.100:9443/minio
#免出现一堆Failed to parse source map from 'C:\home\sei-pageend\principal\node_modules\customize-easy-ui-component\' file: Error: ENOENT: no such file
#太多的告警报错了，屏蔽；解决一个问题，但同时引入另一个毛病需要清除缓存重启环境？
GENERATE_SOURCEMAP=false
NEXT_PUBLIC_APP_TEST=true

# NEXT AUTH
# ===================================
NEXTAUTH_URL=https://192.168.0.100:9443/report
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this-in-production
#NEXT AUTH涉及的provider，客户端用到
# AUTH_URL=https://192.168.0.100:9443/report/api/auth
AUTH_URL=https://192.168.0.100:9443/api/auth
根据您提供的任务要求，我需要为`.env`文件编写文档注释。不过`.env`文件通常不包含正式的文档注释格式，而是使用行内注释来解释环境变量的用途。

对于`.env`文件，标准的注释方式是使用`#`符号开头的行内注释，例如：

# 应用基础配置
# 数据库连接字符串，格式为: postgres://username:password@host:port/database
DATABASE_URL=postgres://user:pass@localhost:5432/db

# 身份认证配置
# NextAuth.js的加密密钥，至少32字符长度
NEXTAUTH_SECRET=your-secret-key-here
# NextAuth.js的基础URL，需包含子路径(如/report)
NEXTAUTH_URL=http://localhost:3000/report

# 调试模式开关
# 设置为true时启用调试日志
DEBUG=true

请注意这些注释只是示例格式，由于您提供的`.env`文件内容为空，我无法针对具体环境变量编写注释。如果您有具体的`.env`文件内容需要注释，请提供相关内容。

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

