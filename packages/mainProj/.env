NODE_USE_SYSTEM_CA=1
#直接添加.env文件 调试启动就受到两个参数影响了。
#这两个设置仅仅针对开发环境，前端编译文件上传静态服务器的生产环境根本不受它作用的。
HTTPS=false
PORT=3765
#本机是后端服务端，在本机电脑的测试：
#REACT_APP_BACK_END=http://192.168.1.105:8673
#REACT_APP_BACK_END=http://localhost:8673

#浏览器直接读取做地址，在手机测试，必须是从外网可以访问的地址。
REACT_APP_BACK_END=http://192.168.109.66:8673
NEXT_PUBLIC_BACK_END=http://192.168.109.66:8673
NEXT_PUBLIC_TOKEN_EXPIRESEC=3600000

#REACT_APP_BACK_END=http://192.168.3.172:8673

#REACT_APP_BACK_END=http://27.151.117.65:8673
