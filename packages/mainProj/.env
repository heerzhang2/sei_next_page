# 调试模式开关
# 设置为true时启用调试日志
DEBUG=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# 信任代理头部，解决反向代理场景下的 Server Actions 验证问题
NODE_ENV=development
VERCEL_URL=192.168.171.3:9443
VERCEL_SCHEME=https

