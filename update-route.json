{
  "uri": "/report*",
  "upstream": {
    "nodes": [
      {
        "host": "host.docker.internal",
        "port": 3765,
        "weight": 1
      }
    ],
    "type": "roundrobin",
    "scheme": "http",
    "timeout": {
      "connect": 60,
      "read": 300,
      "send": 60
    }
  },
  "plugins": {
    "cors": {
      "exposed_headers": ["Content-Length"],
      "headers": ["Content-Type", "Authorization"],
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "origin": "*"
    },
    "proxy-rewrite": {
      "regex_uri": [
        "^/report/(.*)",
        "/$1"
      ]
    }
  },
  "enable_websocket": true,
  "priority": 150
}
