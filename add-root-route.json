{
  "uri": "/report",
  "upstream": {
    "nodes": [
      {
        "host": "host.docker.internal",
        "port": 3765,
        "weight": 1
      }
    ],
    "type": "roundrobin",
    "scheme": "http"
  },
  "plugins": {
    "proxy-rewrite": {
      "uri": "/"
    },
    "cors": {
      "exposed_headers": ["Content-Length"],
      "headers": ["Content-Type", "Authorization"],
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "origin": "*"
    }
  },
  "priority": 140,
  "enable_websocket": true
}
