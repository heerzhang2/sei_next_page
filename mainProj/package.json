{
  "name": "sei_next_page",
  "version": "0.3.0",
  "private": true,
  "author": "何尔章",
  "description": "特检院的前端--主要业务的部分",
  "packageManager": "yarn@4.0.1",
  "scripts": {
    "yarn": "yarn",
    "dev": "next dev --turbopack",
    "dev2": "next dev",
    "build": "next build",
    "start生产版Node.js server": "next start",
    "relay": "yarn run relay-compiler",
    "build all": "relay-compiler && next build",
    "start-server": "next start -p 3002",
    "lint": "next lint",
    "relay2": "relay-compiler --watch",
    "update-schema_本机服务端": "get-graphql-schema  http://localhost:8673/graphql > src/relay/schema.graphql",
    "relay3": "relay-compiler --validate"
  },
  "dependencies": {
    "next-auth": "5.0.0-beta.25",
    "react-toastify": "^11.0.0",
    "hash.js": "^1.1.7",
    "customize-easy-ui-component": "5.5.0",
    "framer-motion": "^12.4.1",
    "swr": "^2.3.2",
    "react-icons": "^5.4.0",
    "lucide-react": "^0.454.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-relay": "^18.2.0",
    "relay-runtime": "^18.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "babel-plugin-relay": "^18.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-relay": "18.2.0",
    "@types/relay-runtime": "^18.2.5",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "relay-compiler": "^18.2.0",
    "get-graphql-schema": "^2.1.2",
    "typescript": "^5"
  },
  "resolutions": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "relay": {
    "src": "src/",
    "schema": "src/relay/schema.graphql",
    "schemaExtensions": [
      "src/relay/clientSchema.graphql"
    ],
    "language": "typescript"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
