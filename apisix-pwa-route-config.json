{
  "uri": "/report/*",
  "plugins": {
    "proxy-rewrite": {
      "regex_uri": ["/report/(.*)", "/$1"]
    },
    "response-rewrite": {
      "vars": [
        ["status", "==", 502],
        ["uri", "~~", "\\.(html|js|css)$"]
      ],
      "headers": {
        "set": {
          "X-PWA-Offline-Hint": "true",
          "Cache-Control": "public, max-age=60"
        }
      }
    },
    "fault-injection": {
      "abort": {
        "http_status": 503,
        "body": "<!DOCTYPE html><html><head><title>服务维护中</title><script>setTimeout(()=>window.location.reload(),3000)</script></head><body style=\"display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;\"><div style=\"text-align:center;\"><h2>⚠️ 服务维护中</h2><p>3秒后自动重试...</p></div></body></html>"
      },
      "vars": [
        ["upstream_status", "==", 502],
        ["uri", "~~", "^/report/(pwa|~offline)"]
      ]
    }
  },
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "sei-nextjs.seirep.svc.cluster.local:3765": 1
    },
    "timeout": {
      "connect": 5,
      "send": 10,
      "read": 30
    },
    "scheme": "http",
    "pass_host": "pass",
    "retries": 2,
    "keepalive_pool": {
      "idle_timeout": 60,
      "requests": 1000,
      "size": 320
    },
    "healthcheck": {
      "active": {
        "http_path": "/healthz",
        "healthy": {
          "interval": 5,
          "successes": 2
        },
        "unhealthy": {
          "interval": 2,
          "http_failures": 3,
          "tcp_failures": 3
        },
        "timeout": 3,
        "req_headers": {
          "User-Agent": "APISIX-HealthCheck"
        }
      },
      "passive": {
        "healthy": {
          "http_statuses": [200],
          "successes": 3
        },
        "unhealthy": {
          "http_statuses": [502, 503, 504],
          "http_failures": 3,
          "tcp_failures": 2
        }
      }
    }
  }
}
